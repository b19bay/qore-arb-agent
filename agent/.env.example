# Copy to .env and fill in. NEVER commit .env — it holds the agent key.
# Devnet defaults (qorechain-devnet, EVM 9800, http://localhost:8545).
RPC_URL=http://localhost:8545
CHAIN_ID=9800
CHAIN_NAME=QoreChain Devnet

# Filled in after `forge script script/Deploy.s.sol --broadcast`:
VAULT_ADDRESS=
POOL_A=
POOL_B=
TOKEN_ADDRESS=
# Block the vault was deployed at (narrows the audit-log scan; 0 = genesis).
FROM_BLOCK=0

# Agent EOA private key (0x...). Devnet test key ONLY — never a mainnet key.
AGENT_PRIVATE_KEY=

# Agent behaviour (defaults shown):
TRADE_SIZE_QOR=0.2
SPREAD_THRESHOLD_BPS=50
SLIPPAGE_BPS=100
INTERVAL_SECONDS=30
MAX_TRADES=4
DURATION_MINUTES=10
GAS_MODE=legacy
